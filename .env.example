# Copy this file to .env and fill in real values. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000
TIME_ZONE=Europe/London

# --- Demo data (local only): loads treatments, prices, an admin login and fake bookings ---
SEED_DEMO=1
DEMO_BOOKINGS=120

# --- PostgreSQL (host is the compose service name) ---
POSTGRES_DB=booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery (host is the compose service name) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# --- Email: local dev uses Mailpit (web inbox at http://localhost:8025) ---
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=Clearline Laser Studio <bookings@example.com>
OWNER_NOTIFICATION_EMAIL=owner@example.com

# --- Business details shown on the site ---
BUSINESS_NAME=Clearline Laser Studio
BUSINESS_ADDRESS=Unit 4, 12 Example Street, London E1 0AA
BUSINESS_PHONE=020 0000 0000
BUSINESS_EMAIL=hello@example.com
BUSINESS_INSTAGRAM=https://instagram.com/
BUSINESS_TIKTOK=https://tiktok.com/

# --- Booking rules ---
SLOT_STEP_MINUTES=15
MIN_NOTICE_HOURS=12
MAX_DAYS_AHEAD=60
CANCELLATION_WINDOW_HOURS=48
UNPAID_HOLD_MINUTES=30

# --- Production only (leave blank locally) ---
DOMAIN=
SENTRY_DSN=
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=

# --- Stripe deposits (optional; blank = deposit paid in clinic). Use test keys first ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
